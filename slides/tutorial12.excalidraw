      "fontSize": 28,
      "fontFamily": 1,
      "text": "Abstraction:\nSolving problems by creating abstract data types to represent\nproblem components; which represent data and actions.",
      "baseline": 166,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Abstraction:\nSolving problems by creating abstract data types to represent\nproblem components; which represent data and actions.",
      "index": "b10",
      "frameId": null,
      "roundness": null,
      "autoResize": true,
