      "boundElements": [],
      "updated": 1748306810389,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 1,
      "text": "With Lambda:\n\nRunnable r = () -> System.out.println(\"Hello\");\n",
      "baseline": 238,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "With Lambda:\n\nRunnable r = () -> System.out.println(\"Hello\");\n",
