      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 1,
      "text": "Encapsulation:\nThe details of a class should be kept hidden or private,\nand the user's ability to access hidden details is\nrestricted or controlled.",
      "baseline": 17,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Encapsulation:\nThe details of a class should be kept hidden or private,\nand the user's ability to access hidden details is\nrestricted or controlled.",
      "index": "b11",
      "frameId": null,
      "roundness": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
