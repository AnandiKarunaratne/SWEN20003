      "fontSize": 28,
      "fontFamily": 1,
      "text": "public void printNumbers(int... numbers) {\n    for (int num : numbers) {\n        System.out.println(num);\n    }\n}\n",
      "baseline": 60,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public void printNumbers(int... numbers) {\n    for (int num : numbers) {\n        System.out.println(num);\n    }\n}\n",
      "index": "b0l",
      "frameId": null,
      "roundness": null,
      "autoResize": true,
      "lineHeight": 1.2678571428571428
    },
    {
