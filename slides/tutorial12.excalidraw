      "updated": 1748307286786,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 1,
      "text": "Why Use Variadic Methods?\n\n- To avoid overloading the same method with different numbers of parameters.\n- To make code more flexible and concise.\n\n",
      "baseline": 91,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why Use Variadic Methods?\n\n- To avoid overloading the same method with different numbers of parameters.\n- To make code more flexible and concise.\n\n",
      "index": "b0n",
      "frameId": null,
      "roundness": null,
      "autoResize": true,
      "lineHeight": 1.225
